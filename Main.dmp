00381  81EB             ; ================================================================
00382  81EB             ; ROUTINE: DEVIDEBY10_BINARY
00383  81EB             ; DIVIDES AN 8-BIT UNSIGNED INTEGER BY 10 USING BINARY LONG DIVISION.
00384  81EB             ;
00385  81EB             ; INPUTS:  A = DIVIDEND (0 - 255)
00386  81EB             ; OUTPUTS: X = QUOTIENT (A / 10)
00387  81EB             ;          A = REMAINDER (A % 10)
00388  81EB             ; PRESERVES: Y REGISTER (UNTOUCHED, SAFE FOR OUTER LOOPS)
00389  81EB             ; REQUIRES: 1 BYTE OF ZERO PAGE OR RAM MEMORY (TMPFB)
00390  81EB             ; ================================================================
00391  81EB             
00392  81EB             DEVIDEBY10_BINARY 
00393  81EB  8D DE 82              STA TMPFB           ; STORE THE ORIGINAL DIVIDEND IN A TEMPORARY BUFFER
00394  81EE  A9 00                 LDA #$00            ; CLEAR ACCUMULATOR (WILL ACCUMULATE THE REMAINDER)
00395  81F0  A2 08                 LDX #$08            ; LOOP COUNTER: 8 BITS TO PROCESS
00396  81F2             
00397  81F2             @DIVLOOP
00398  81F2  0E DE 82              ASL TMPFB           ; SHIFT THE MSB OF THE DIVIDEND OUT INTO THE CARRY FLAG.
00399  81F5                        ; (THIS ALSO FORCES BIT 0 OF TMPFB TO BECOME 0)
00400  81F5                        
00401  81F5  2A                    ROL                 ; ROTATE THE CARRY BIT INTO THE REMAINDER ACCUMULATOR (A)
00402  81F6                        
00403  81F6  C9 0A                 CMP #10             ; COMPARE THE ACCUMULATED REMAINDER AGAINST THE DIVISOR (10)
00404  81F8  90 05                 BCC @SKIPSUB        ; IF REMAINDER < 10, BRANCH AND LEAVE BIT 0 OF TMPFB AS 0
00405  81FA                        
00406  81FA  E9 0A                 SBC #10             ; IF REMAINDER >= 10, SUBTRACT 10 FROM THE REMAINDER
00407  81FC  EE DE 82              INC TMPFB           ; INCREMENT TMPFB TO SET BIT 0 TO 1 (THIS IS THE QUOTIENT BIT)
00408  81FF             
00409  81FF             @SKIPSUB
00410  81FF  CA                    DEX                 ; DECREMENT THE BIT LOOP COUNTER
00411  8200  D0 F0                 BNE @DIVLOOP        ; REPEAT THE LOOP UNTIL ALL 8 BITS ARE PROCESSED
00412  8202             
00413  8202  AE DE 82              LDX TMPFB           ; MOVE THE FINAL COMPLETED QUOTIENT FROM THE BUFFER INTO X
00414  8205                        
00415  8205                        ; AT THIS POINT, A ALREADY RETAINS THE CORRECT REMAINDER (A = A % 10)
00416  8205  60                    RTS
00417  8206             
