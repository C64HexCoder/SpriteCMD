00379  81E8             ; ================================================================
00380  81E8             ; ROUTINE: DEVIDEBY10_BINARY
00381  81E8             ; DIVIDES AN 8-BIT UNSIGNED INTEGER BY 10 USING BINARY LONG DIVISION.
00382  81E8             ;
00383  81E8             ; INPUTS:  A = DIVIDEND (0 - 255)
00384  81E8             ; OUTPUTS: X = QUOTIENT (A / 10)
00385  81E8             ;          A = REMAINDER (A % 10)
00386  81E8             ; PRESERVES: Y REGISTER (UNTOUCHED, SAFE FOR OUTER LOOPS)
00387  81E8             ; REQUIRES: 1 BYTE OF ZERO PAGE OR RAM MEMORY (TMPFB)
00388  81E8             ; ================================================================
00389  81E8             
00390  81E8             DEVIDEBY10_BINARY 
00391  81E8  8D 85 82              STA TMPFB           ; STORE THE ORIGINAL DIVIDEND IN A TEMPORARY BUFFER
00392  81EB  A9 00                 LDA #$00            ; CLEAR ACCUMULATOR (WILL ACCUMULATE THE REMAINDER)
00393  81ED  A2 08                 LDX #$08            ; LOOP COUNTER: 8 BITS TO PROCESS
00394  81EF             
00395  81EF             @DIVLOOP
00396  81EF  0E 85 82              ASL TMPFB           ; SHIFT THE MSB OF THE DIVIDEND OUT INTO THE CARRY FLAG.
00397  81F2                        ; (THIS ALSO FORCES BIT 0 OF TMPFB TO BECOME 0)
00398  81F2                        
00399  81F2  2A                    ROL                 ; ROTATE THE CARRY BIT INTO THE REMAINDER ACCUMULATOR (A)
00400  81F3                        
00401  81F3  C9 0A                 CMP #10             ; COMPARE THE ACCUMULATED REMAINDER AGAINST THE DIVISOR (10)
00402  81F5  90 05                 BCC @SKIPSUB        ; IF REMAINDER < 10, BRANCH AND LEAVE BIT 0 OF TMPFB AS 0
00403  81F7                        
00404  81F7  E9 0A                 SBC #10             ; IF REMAINDER >= 10, SUBTRACT 10 FROM THE REMAINDER
00405  81F9  EE 85 82              INC TMPFB           ; INCREMENT TMPFB TO SET BIT 0 TO 1 (THIS IS THE QUOTIENT BIT)
00406  81FC             
00407  81FC             @SKIPSUB
00408  81FC  CA                    DEX                 ; DECREMENT THE BIT LOOP COUNTER
00409  81FD  D0 F0                 BNE @DIVLOOP        ; REPEAT THE LOOP UNTIL ALL 8 BITS ARE PROCESSED
00410  81FF             
00411  81FF  AE 85 82              LDX TMPFB           ; MOVE THE FINAL COMPLETED QUOTIENT FROM THE BUFFER INTO X
00412  8202                        
00413  8202                        ; AT THIS POINT, A ALREADY RETAINS THE CORRECT REMAINDER (A = A % 10)
00414  8202  60                    RTS
