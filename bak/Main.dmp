00370  81D9             ; ================================================================
00371  81D9             ; ROUTINE: DEVIDEBY10_BINARY
00372  81D9             ; INPUTS:  A = DIVIDEND (0 - 255)
00373  81D9             ; OUTPUTS: X = QUOTIENT (A / 10), A = REMAINDER (A % 10)
00374  81D9             ; PRESERVES: Y (CRUCIAL FOR NUMTOASCII STACK COUNTER!)
00375  81D9             ; ================================================================
00376  81D9             DEVIDEBY10_BINARY 
00377  81D9  8D 22 C0              STA TMPFB           ; STORE DIVIDEND IN TEMPORARY VARIABLE
00378  81DC  A9 00                 LDA #$00            ; CLEAR ACCUMULATOR (REMAINDER)
00379  81DE  A2 08                 LDX #$08            ; 8 BITS LOOP COUNTER
00380  81E0             
00381  81E0             @DIVLOOP
00382  81E0  0E 22 C0              ASL TMPFB           ; SHIFT MSB OF DIVIDEND OUT TO CARRY
00383  81E3  2E 23 C0              ROL TMPFB+1
00384  81E6  2A                    ROL                 ; ROTATE CARRY INTO REMAINDER (A)
00385  81E7  C9 0A                 CMP #10             ; IS REMAINDER >= 10?
00386  81E9  90 02                 BCC @SKIPSUB
00387  81EB  E9 0A                 SBC #10             ; SUBTRACT 10 (CARRY BECOMES/REMAINS 1)
