00372  81DC             
00373  81DC             ; ================================================================
00374  81DC             ; ROUTINE: DEVIDEBY10_BINARY
00375  81DC             ; DIVIDES AN 8-BIT UNSIGNED INTEGER BY 10 USING BINARY LONG DIVISION.
00376  81DC             ;
00377  81DC             ; INPUTS:  A = DIVIDEND (0 - 255)
00378  81DC             ; OUTPUTS: X = QUOTIENT (A / 10)
00379  81DC             ;          A = REMAINDER (A % 10)
00380  81DC             ; PRESERVES: Y REGISTER (UNTOUCHED, SAFE FOR OUTER LOOPS)
00381  81DC             ; REQUIRES: 1 BYTE OF ZERO PAGE OR RAM MEMORY (TMPFB)
00382  81DC             ; ================================================================
00383  81DC             
00384  81DC             DEVIDEBY10_BINARY 
00385  81DC  8D 44 82              STA TMPFB           ; STORE THE ORIGINAL DIVIDEND IN A TEMPORARY BUFFER
00386  81DF  A9 00                 LDA #$00            ; CLEAR ACCUMULATOR (WILL ACCUMULATE THE REMAINDER)
00387  81E1  A2 08                 LDX #$08            ; LOOP COUNTER: 8 BITS TO PROCESS
00388  81E3             
00389  81E3             @DIVLOOP
00390  81E3  0E 44 82              ASL TMPFB           ; SHIFT THE MSB OF THE DIVIDEND OUT INTO THE CARRY FLAG.
00391  81E6                        ; (THIS ALSO FORCES BIT 0 OF TMPFB TO BECOME 0)
00392  81E6                        
00393  81E6  2A                    ROL                 ; ROTATE THE CARRY BIT INTO THE REMAINDER ACCUMULATOR (A)
00394  81E7                        
00395  81E7  C9 0A                 CMP #10             ; COMPARE THE ACCUMULATED REMAINDER AGAINST THE DIVISOR (10)
00396  81E9  90 05                 BCC @SKIPSUB        ; IF REMAINDER < 10, BRANCH AND LEAVE BIT 0 OF TMPFB AS 0
00397  81EB                        
00398  81EB  E9 0A                 SBC #10             ; IF REMAINDER >= 10, SUBTRACT 10 FROM THE REMAINDER
00399  81ED  EE 44 82              INC TMPFB           ; INCREMENT TMPFB TO SET BIT 0 TO 1 (THIS IS THE QUOTIENT BIT)
00400  81F0             
00401  81F0             @SKIPSUB
00402  81F0  CA                    DEX                 ; DECREMENT THE BIT LOOP COUNTER
00403  81F1  D0 F0                 BNE @DIVLOOP        ; REPEAT THE LOOP UNTIL ALL 8 BITS ARE PROCESSED
00404  81F3             
00405  81F3  AE 44 82              LDX TMPFB           ; MOVE THE FINAL COMPLETED QUOTIENT FROM THE BUFFER INTO X
00406  81F6                        
00407  81F6                        ; AT THIS POINT, A ALREADY RETAINS THE CORRECT REMAINDER (A = A % 10)
00408  81F6  60                    RTS
00409  81F7             
