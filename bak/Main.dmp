00362  81CE  A2 00                 LDX #$00
00363  81D0             DIVLOOP
00364  81D0  C9 0A                 CMP #$0A
00365  81D2  90 07                 BCC ENDDIV
00366  81D4  E8                    INX
00367  81D5  38                    SEC
